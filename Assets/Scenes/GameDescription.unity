  m_Text: "\t\u3053\u306E\u30B2\u30FC\u30E0\u306F\u3001\u81EA\u8EE2\u8ECA\u306E\u4EA4\u901A\u30EB\u30FC\u30EB\u3092\u5B66\u3073\u306A\u304C\u3089\u8857\u3092\u99C6\u3051\u629C\u3051\u308B\u30B7\u30DF\u30E5\u30EC\u30FC\u30BF\u30FC\u3067\u3059\u3002\r\n\r\n\u81EA\u8EE2\u8ECA\u306F\u5E38\u306B\u81EA\u52D5\u3067\u524D\u306B\u9032\u307F\u307E\u3059\r\n\t\u8FD1\u304F\u306B\u8B66\u5BDF\u304C\u3044\u308B\u72B6\u614B\u3067\u9055\u53CD\u3092\u3057\u3066\u3057\u307E\u3046\u3068
